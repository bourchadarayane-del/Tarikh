# =====================================================================
# Tarikh — variables d'environnement
# 1. Copiez ce fichier en « .env.local » (jamais commité) et remplissez les valeurs.
# 2. Recopiez les mêmes variables dans Vercel > Project > Settings > Environment Variables
#    (cochez Production ET Preview).
# Ne mettez JAMAIS de vraie clé dans ce fichier d'exemple.
# =====================================================================

# ---------- Public (peut être vu par le navigateur) ----------
# Adresse du site (sans / final). Sert aussi d'adresse d'API pour l'application iOS.
PUBLIC_SITE_URL=https://tarikh-topaz.vercel.app
# Supabase > Project Settings > API > Project URL
SUPABASE_URL=https://klcqcxbjvrblcwkrvkur.supabase.co
# Supabase > Project Settings > API > clé « anon » / « publishable » (publique, protégée par les règles RLS)
SUPABASE_ANON_KEY=
# OneSignal > Settings > Keys & IDs > App ID (public).
# Laissez VIDE tant que la plateforme iOS (APNs) n'est pas configurée : l'appli utilisera alors un rappel local quotidien.
ONESIGNAL_APP_ID=
# RevenueCat > Project > API keys > clé publique de l'app iOS (commence par « appl_ »). Publique, embarquée dans l'appli.
REVENUECAT_IOS_PUBLIC_KEY=

# ---------- SECRET (serveur uniquement : Vercel + .env.local) ----------
# Supabase > Project Settings > API > clé « service_role » / « secret ». Donne tous les droits : ne jamais l'exposer.
SUPABASE_SERVICE_ROLE_KEY=
# console.anthropic.com > API keys (créez une NOUVELLE clé : l'ancienne a été exposée et doit être révoquée).
ANTHROPIC_KEY=
# Facultatif : modèle utilisé pour l'histoire du jour (défaut : claude-sonnet-4-5).
ANTHROPIC_MODEL=
# Chaîne aléatoire d'au moins 32 caractères (ex. : openssl rand -hex 32). Protège /api/cron-daily et /api/generate.
CRON_SECRET=
# Stripe (WEB uniquement) > Developers > API keys > Secret key (mode test d'abord).
STRIPE_SECRET_KEY=
# Stripe > Developers > Webhooks > votre endpoint > Signing secret.
STRIPE_WEBHOOK_SECRET=
# Stripe > Product catalogue > Tarikh Premium > identifiant du tarif mensuel 4,99 € (commence par « price_ »).
STRIPE_PRICE_ID=
# RevenueCat > Integrations > Webhooks > valeur de l'en-tête Authorization que VOUS choisissez (chaîne aléatoire).
REVENUECAT_WEBHOOK_SECRET=
# RevenueCat > Project > API keys > Secret API key (v1). Sert à vérifier un achat tout de suite, sans attendre le webhook.
REVENUECAT_SECRET_API_KEY=
# OneSignal > Settings > Keys & IDs > REST API Key. Sert à envoyer la notification quotidienne.
ONESIGNAL_REST_API_KEY=
