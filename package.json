{
  "name": "tarikh",
  "version": "1.0.0",
  "private": true,
  "description": "Tarikh – daily Islamic history app (web PWA + iOS via Capacitor)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "lint": "node scripts/check-syntax.mjs && node scripts/check-i18n.mjs",
    "test": "node scripts/check-syntax.mjs && node scripts/check-i18n.mjs && node scripts/check-secrets.mjs && node --test tests/*.test.mjs && bash scripts/test-sql.sh",
    "test:e2e": "node scripts/build.mjs && node tests/e2e/run.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "seed:build": "node scripts/build-seed.mjs",
    "icons": "node scripts/make-icons.mjs",
    "screenshots": "node scripts/build.mjs && node scripts/make-screenshots.mjs",
    "ios:sync": "node scripts/build.mjs && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "test:sql": "bash scripts/test-sql.sh",
    "ios:configure": "node scripts/configure-ios.mjs",
    "ios:build": "bash scripts/build-ios.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "stripe": "^23.2.0"
  },
  "devDependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/cli": "^8.6.3",
    "@capacitor/core": "^8.6.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/geolocation": "^8.2.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/noto-nastaliq-urdu": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@revenuecat/purchases-capacitor": "^15.0.0",
    "adhan": "^4.4.6",
    "all-the-cities": "^3.1.0",
    "esbuild": "^0.28.2",
    "onesignal-cordova-plugin": "^5.6.3",
    "typescript": "^5.6.0"
  }
}
